# ---------------------------------------------------------------------
# EIMS configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=            # python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=eims.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://eims.example.org
DJANGO_SECURE_SSL_REDIRECT=true

# Column-level encryption for identifying fields.
# python -c "from apps.core.crypto import generate_key;print(generate_key())"
EIMS_FIELD_KEY=
EIMS_FACILITY_NAME=Your Health Facility
EIMS_ARTIFACT_LINK_MAX_AGE=1209600

# Database
DB_NAME=eims
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (omit EMAIL_HOST to fall back to the console backend)
DEFAULT_FROM_EMAIL=no-reply@eims.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# SMS gateway (omit to run the loopback dispatcher)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SITE_URL=https://eims.example.org
